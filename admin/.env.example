# Event Nu admin console (BFF).
#
# Copy to .env.local. NEVER commit .env.local. The BFF proxies the real API so
# the browser never talks to it directly.
#
# The Event Nu backend base URL (http://localhost:8080 for local dev).
API_BASE_URL=http://localhost:8080

# Shared secret the admin login form requires in addition to the account
# credentials. Pick a long random value; it is enforced constant-time here and
# the real authorization happens in the backend (RequireAdmin).
ADMIN_PANEL_SECRET=change-me-to-a-long-random-string

# Must match the backend's JWT_SECRET so the middleware can verify the access
# token. Share the same value used by the Event Nu API.
JWT_SECRET=change-me-to-the-backend-jwt-secret