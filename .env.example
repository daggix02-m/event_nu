# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
PORT=8080

# --- Database (Neon) ---
DATABASE_ADMIN_URL=postgresql://<owner_role>:<password>@<host>/<db>?sslmode=require
# app_user role runs the API/worker under RLS (worker presets role=service)
DATABASE_URL=postgresql://app_user:<password>@<host>/<db>?sslmode=require
# --- CI / local Postgres (see backend/README.md "CI quality gates") ---
# Same variables, but pointed at a throwaway postgres:16 container, e.g.:
#   DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/event_nu_test?sslmode=disable
#   DATABASE_URL=postgres://app_user:app_user_pass@localhost:5433/event_nu_test?sslmode=disable
# CI additionally exports JWT_SECRET (any non-empty value) and EMAIL_PROVIDER=noop
# so the Brevo fail-fast guards don't block tests.

# --- Brevo transactional email ---
BREVO_API_KEY=xkeysib-...
BREVO_API_SENDER=<verified technical sender>
BREVO_SENDER_EMAIL=event.nua@gmail.com
BREVO_SENDER_NAME="Event Nu"
EMAIL_PROVIDER=brevo
# Transactional template IDs (create in Brevo dashboard, then set)
BREVO_TEMPLATE_WELCOME=<id>
BREVO_TEMPLATE_VERIFY=<id>

# --- Auth ---
JWT_SECRET=<generate-with: openssl rand -base64 32>
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# --- Tickets & orders (see docs/ticket-qr-protocol.md) ---
# HMAC key for ticket QR payloads. Optional: defaults to JWT_SECRET when unset.
# Rotate in a low-activity window (rotation invalidates outstanding tickets).
TICKET_QR_SECRET=<generate-with: openssl rand -base64 32>

# --- Payments (Chapa) — see docs/chapa.md ---
# PAYMENT_PROVIDER=noop keeps order creation checkout-free (dev/tests).
# Set to "chapa" to enable real checkouts: order-create returns a redirect_url
# and /webhooks/payments/chapa finalizes orders. Requires CHAPA_SECRET_KEY.
PAYMENT_PROVIDER=noop
CHAPA_SECRET_KEY=
# Optional overrides: API root for sandbox/mock, HMAC key for webhook signature
# verification (defaults to CHAPA_SECRET_KEY), and the return_url base.
CHAPA_API_BASE=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=
CHAPA_REDIRECT_BASE=

# --- Offline sync (see docs/sync-protocol.md) ---
# Max changes per domain per sync poll (1..1000). Default 500.
SYNC_MAX_LIMIT=500

# --- Push notifications (FCM) — see docs/push.md ---
# PUSH_PROVIDER=noop keeps the worker from touching Firebase (dev/tests).
# Set to "fcm" for real push — requires FCM_SERVICE_ACCOUNT and FCM_PROJECT_ID.
PUSH_PROVIDER=noop
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=
# Optional overrides (defaults below).
FCM_API_BASE=https://fcm.googleapis.com/v1
FCM_TOKEN_URL=https://oauth2.googleapis.com/token

# Push worker tuning (defaults match config.Load)
PUSH_POLL_INTERVAL=2s
PUSH_BATCH_SIZE=50
PUSH_MAX_ATTEMPTS=5
PUSH_RETRY_BASE_DELAY=30s

# --- Auth rate limiting (single-instance in-memory fixed window) ---
# Each pair guards the IP bucket; login/register also guard the account bucket.
# login/verify default limit 20 per window; register 5 per 1h; refresh 30 per 5m
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW=5m
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW=1h
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW=5m
AUTH_VERIFY_RATE_LIMIT=20
AUTH_VERIFY_RATE_WINDOW=1h

# --- CORS ---
# Comma-separated origin allowlist (default: empty = same-origin only)
CORS_ALLOWED_ORIGINS=

# --- Outbox worker tuning (defaults match config.Load) ---
EMAIL_POLL_INTERVAL=2s
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY=30s

# --- Email transport ---
# Brevo API base (override for EU region), and the public base URL used to
# build the eventnu:// verify deep link.
BREVO_API_BASE=https://api.brevo.com
API_PUBLIC_BASE=http://localhost:8080